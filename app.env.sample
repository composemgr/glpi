# GLPI environment configuration
# Copy to app.env and customize before starting

# Timezone
TZ=America/New_York

# GLPI version (set to a specific version tag to pin, e.g. 10.0.15)
GLPI_VERSION=latest

# Database (MariaDB)
DB_CREATE_DATABASE_NAME=glpi
DB_USER_NAME=glpi
DB_USER_PASS=changeme_db_password
DB_ADMIN_PASS=changeme_admin_password
